<div class="form__row">
  <label class="field"><span>Prénom</span><input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label class="field"><span>Nom</span><input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label class="field"><span>Société</span><input type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label class="field"><span>Adresse</span><input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label class="field"><span>Complément</span><input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="form__row">
  <label class="field"><span>Code postal</span><input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
  <label class="field"><span>Ville</span><input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
</div>
<div class="form__row">
  <label class="field"><span>Pays</span><select name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></label>
  <label class="field"><span>Région</span><input type="text" name="address[province]" value="{{ form.province }}"></label>
</div>
<label class="field"><span>Téléphone</span><input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="check">{{ form.set_as_default_checkbox }} Adresse par défaut</label>
