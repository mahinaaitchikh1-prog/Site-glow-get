{%- comment -%}
  Contenu du panier, partagé par le tiroir et la page panier.
  - context : 'drawer' | 'page'
{%- endcomment -%}
{%- if cart.item_count > 0 -%}
  <ul class="cart-lines" role="list">
    {%- for item in cart.items -%}
      <li class="cart-line" data-line="{{ forloop.index }}">
        <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
          {% render 'media-slot', image: item.image, ratio: settings.product_ratio, label: 'Photo', sizes: '120px', class: 'slot--mini' %}
        </a>
        <div class="cart-line__info">
          <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
          <p class="cart-line__sku">Réf. {{ item.sku | default: '—' }}</p>
          {%- unless item.product.has_only_default_variant -%}
            <dl class="cart-line__opts">
              {%- for option in item.options_with_values -%}
                <div><dt>{{ option.name }}</dt><dd>{{ option.value }}</dd></div>
              {%- endfor -%}
            </dl>
          {%- endunless -%}
          {%- for property in item.properties -%}
            {%- unless property.last == blank or property.first contains '_' -%}
              <p class="cart-line__prop">{{ property.first }} : {{ property.last }}</p>
            {%- endunless -%}
          {%- endfor -%}
          <p class="cart-line__unit">
            {{ item.final_price | money }}
            {%- if item.original_price > item.final_price %} <s>{{ item.original_price | money }}</s>{% endif -%}
          </p>

          <div class="cart-line__row">
            <div class="qty" data-qty>
              <button type="button" class="qty__btn" data-line-change="{{ forloop.index }}" data-qty-to="{{ item.quantity | minus: 1 }}" aria-label="Retirer une unité de {{ item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
              <input
                type="number"
                class="qty__input"
                value="{{ item.quantity }}"
                min="0"
                {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}max="{{ item.variant.inventory_quantity }}"{% endif %}
                data-line-input="{{ forloop.index }}"
                aria-label="Quantité de {{ item.product.title | escape }}"
              >
              <button type="button" class="qty__btn" data-line-change="{{ forloop.index }}" data-qty-to="{{ item.quantity | plus: 1 }}" aria-label="Ajouter une unité de {{ item.product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
            </div>
            <button type="button" class="link-ui link-ui--underline cart-line__remove" data-line-change="{{ forloop.index }}" data-qty-to="0">Supprimer</button>
          </div>
        </div>
        <p class="cart-line__total">{{ item.final_line_price | money }}</p>
      </li>
    {%- endfor -%}
  </ul>
{%- else -%}
  <div class="cart-empty">
    {% render 'ornament', type: 'bow', class: 'cart-empty__bow' %}
    <p class="cart-empty__title">Votre panier est vide</p>
    <p class="cart-empty__text">Les pièces que vous ajoutez apparaîtront ici.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--solid">Découvrir la boutique</a>
  </div>
{%- endif -%}
