<section class="section-space">
  <div class="page-width account-narrow">
    <header class="section-head section-head--center">
      <p class="section-head__kicker">bienvenue</p>
      <h1 class="section-head__title">Créer un compte</h1>
      {% render 'ornament', type: 'divider', class: 'section-head__divider' %}
    </header>
    {%- form 'create_customer', class: 'form' -%}
      {%- if form.errors -%}<div class="form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form__row">
        <label class="field"><span>Prénom</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
        <label class="field"><span>Nom</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
      </div>
      <label class="field"><span>E-mail</span><input type="email" name="customer[email]" autocomplete="email" required></label>
      <label class="field"><span>Mot de passe</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="check"><input type="checkbox" name="customer[accepts_marketing]" value="true"> Je souhaite rejoindre le GLOW&amp;GET Club</label>
      <button type="submit" class="btn btn--solid btn--wide">Créer mon compte</button>
    {%- endform -%}
  </div>
</section>
