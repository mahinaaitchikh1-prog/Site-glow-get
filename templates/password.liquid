{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}, bientôt</title>
    {{ 'font-cormorant-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {% render 'font-faces' %}
    {% render 'css-variables' %}
    {{ 'glowget.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main class="password">
      {% render 'ornament', type: 'bow', class: 'password__bow' %}
      {% render 'logo', size: 'hero' %}
      <p class="hero__slogan">YOUR STYLE, YOUR GLOW</p>
      {%- if shop.password_message != blank -%}<p class="password__msg">{{ shop.password_message }}</p>{%- endif -%}

      {%- form 'customer', class: 'club__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="club__success" role="status">Merci. Vous serez prévenu(e) à l'ouverture.</p>
        {%- else -%}
          <div class="club__field">
            <label for="PwEmail" class="visually-hidden">Adresse e-mail</label>
            <input id="PwEmail" type="email" name="contact[email]" class="club__input" placeholder="Votre adresse e-mail" required>
            <button type="submit" class="btn btn--solid">Me prévenir</button>
          </div>
          {%- if form.errors -%}<p class="club__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}

      <details class="password__login">
        <summary class="link-ui link-ui--underline">Accès propriétaire</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="club__error">Mot de passe incorrect.</p>{%- endif -%}
          <div class="club__field">
            <label for="Password" class="visually-hidden">Mot de passe</label>
            <input type="password" name="password" id="Password" class="club__input" placeholder="Mot de passe" autocomplete="current-password">
            <button type="submit" class="btn btn--solid">Entrer</button>
          </div>
        {%- endform -%}
      </details>
    </main>
  </body>
</html>
