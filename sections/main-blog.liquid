{%- paginate blog.articles by 9 -%}
  <section class="section-space">
    <div class="page-width">
      <header class="section-head section-head--center">
        <p class="section-head__kicker">le journal</p>
        <h1 class="section-head__title">{{ blog.title }}</h1>
        {% render 'ornament', type: 'divider', class: 'section-head__divider' %}
      </header>
      <div class="grid journal" style="--cols: 3;">
        {%- for article in blog.articles -%}
          <article class="journal__item">
            <a href="{{ article.url }}">
              {% render 'media-slot', image: article.image, ratio: '4 / 5', label: 'Photo article', sizes: '(min-width: 990px) 33vw, 100vw' %}
            </a>
            <p class="journal__date">{{ article.published_at | date: '%d/%m/%Y' }}</p>
            <h2 class="journal__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="journal__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Journal", "settings": [] }
{% endschema %}
