<section class="mosaic section-space bg-{{ section.settings.background }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <header class="section-head section-head--center">
      {%- if section.settings.kicker != blank -%}
        <p class="section-head__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2 class="section-head__title">{{ section.settings.title }}</h2>
      {% render 'ornament', type: 'divider', class: 'section-head__divider' %}
    </header>

    <div class="mosaic__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign img = block.settings.image | default: coll.featured_image
          assign title = block.settings.title | default: coll.title | default: 'Nom de la collection'
          assign url = block.settings.link | default: coll.url | default: routes.collections_url
          assign pos = forloop.index0 | modulo: 4
          case pos
            when 0
              assign ratio = '3 / 4'
              assign fmt = 'Portrait 3:4'
            when 1
              assign ratio = '4 / 5'
              assign fmt = 'Portrait 4:5'
            when 2
              assign ratio = '2 / 3'
              assign fmt = 'Portrait 2:3'
            else
              assign ratio = '16 / 9'
              assign fmt = 'Paysage 16:9'
          endcase
        -%}
        <a href="{{ url }}" class="mosaic__item mosaic__item--{{ pos }}" {{ block.shopify_attributes }}>
          {% render 'media-slot', image: img, ratio: ratio, label: 'Photo collection', format: fmt, sizes: '(min-width: 990px) 33vw, 50vw' %}
          <span class="mosaic__caption">
            <span class="mosaic__title">{{ title }}</span>
            {%- if block.settings.subtitle != blank -%}
              <span class="mosaic__sub">{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mosaïque de collections",
  "class": "section-mosaic",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit texte cursif", "default": "l'univers glow&get" },
    { "type": "text", "id": "title", "label": "Titre", "default": "OUR COLLECTIONS" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "pearl", "label": "Gris perle" },
        { "value": "rose", "label": "Rose poudré" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Photo (remplace celle de la collection)" },
        { "type": "text", "id": "title", "label": "Titre (facultatif)" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre cursif" },
        { "type": "url", "id": "link", "label": "Lien personnalisé (facultatif)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mosaïque de collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Robes", "subtitle": "pour danser" } },
        { "type": "collection", "settings": { "title": "Tops & corsets", "subtitle": "noués de rubans" } },
        { "type": "collection", "settings": { "title": "Jupes", "subtitle": "en mouvement" } },
        { "type": "collection", "settings": { "title": "Accessoires", "subtitle": "les détails" } }
      ]
    }
  ]
}
{% endschema %}
