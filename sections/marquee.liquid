{%- assign items = section.settings.items | split: ',' -%}
<div class="marquee marquee--{{ section.settings.style }}" {{ section.shopify_attributes }}>
  <div class="marquee__track" aria-hidden="true">
    {%- for round in (1..2) -%}
      <div class="marquee__group">
        {%- for i in (1..3) -%}
          {%- for item in items -%}
            <span class="marquee__item">{{ item | strip }}</span>
            {% render 'ornament', type: 'star', class: 'marquee__sep' %}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <p class="visually-hidden">{{ section.settings.items }}</p>
</div>

{% schema %}
{
  "name": "Bandeau défilant",
  "class": "section-marquee",
  "settings": [
    { "type": "text", "id": "items", "label": "Mentions (séparées par des virgules)", "default": "New Collection, Discover Your Style, GLOW&GET, New Arrivals" },
    {
      "type": "select",
      "id": "style",
      "label": "Couleur",
      "options": [
        { "value": "rose", "label": "Rose poudré" },
        { "value": "bordeaux", "label": "Bordeaux" }
      ],
      "default": "rose"
    }
  ],
  "presets": [{ "name": "Bandeau défilant" }]
}
{% endschema %}
